{
  "author": "AnatolyI <ai@rsl.ru>",
  "name": "poppler-simple",
  "description": "A simple interface to poppler library",
  "keywords": [
    "poppler"
  ],
  "version": "0.11.3",
  "repository": {
    "type": "git",
    "url": "git://github.com/blackbeam/poppler-simple.git"
  },
  "scripts": {
    "install": "(node-gyp rebuild) || (exit 1)",
    "test": "./node_modules/.bin/mocha && check-dts",
    "clean": "((node-gyp clean) && (rm -rf node_modules)) || (exit 0)",
    "build-debug": "(node-gyp configure --debug && node-gyp rebuild --debug) || (exit 0)"
  },
  "main": "./lib/poppler.js",
  "types": "./lib/poppler.d.ts",
  "engines": {
    "node": ">=0.10.0"
  },
  "dependencies": {
    "bluebird": "^3.7.2",
    "nan": "^2.23.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "check-dts": "^0.9.0",
    "mocha": "^10.5.2"
  },
  "optionalDependencies": {},
  "mocha": {
    "reporter": "spec",
    "slow": "250",
    "v8-expose-gc": true
  }
}
